# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bigban

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here

# Stripe keys (test)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP (optional) - if you set these, verification and invoice emails will be sent
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Big Ban <no-reply@bigban.edu>"

# Frontend URL (used for success/cancel redirects)
FRONTEND_URL=http://localhost:5173

# Server port
PORT=5000
